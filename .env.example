# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your details:
#   cp .env.example .env
# ==============================================================================

# Optional: Google Drive & Google Sheets Cloud Synchronization
# Set your target Google Drive folder ID to sync tracker.xlsx and DB backups
GDRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Path to your Google Cloud service account JSON key (default: config/service_account.json)
GDRIVE_SERVICE_ACCOUNT=config/service_account.json

# Optional: Claude / Anthropic API Key (if using live Claude Agent SDK LLM calls)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Automation Limits & Safety Caps
DAILY_SUBMISSION_CAP=100
DAILY_BUDGET_DOLLARS=200.0
